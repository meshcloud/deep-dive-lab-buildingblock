# Copy to bin/env.sh (gitignored) and `source bin/env.sh`.
#
# Point these at YOUR meshStack. Log in once with the CLI:
#
#   meshstack login --endpoint "$MESHSTACK_ENDPOINT" --profile "$MESHSTACK_PROFILE"
#
# The Terraform meshstack provider authenticates straight from that CLI profile — no provider block
# and no API key needed for the lab. These exports just make the profile the default for every
# command in the shell.
export MESHSTACK_ENDPOINT="https://federation.<your-meshstack>.meshcloud.io"
export MESHSTACK_PROFILE="<your-profile>"
export MESHSTACK_WORKSPACE="<your-workspace>"

# If you prefer API-key auth (what CI uses), set these instead of the profile and the provider will
# pick them up directly. The key needs permission to manage building block definitions and building
# blocks in the workspace above.
# export MESHSTACK_API_KEY="00000000-0000-0000-0000-000000000000"
# export MESHSTACK_API_SECRET="…"
